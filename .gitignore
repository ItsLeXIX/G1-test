# ---- macOS ----
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---- Xcode: per-user state (window layout, breakpoints, scheme order) ----
# Changes every time someone opens the project; causes pointless commits
# and push/pull conflicts between collaborators.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# ---- Xcode: build output ----
build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ---- Swift Package Manager ----
.build/
.swiftpm/
Packages/

# ---- CocoaPods / Carthage (in case they're added later) ----
Pods/
Carthage/Build/

# ---- Misc ----
*.swp
*~

# ---- Image render pipeline: scratch / generated / downloaded ----
__pycache__/
*.pyc
render_pipeline/out/
render_pipeline/scenes/
render_pipeline/_research/
render_pipeline/_quarantine/
render_pipeline/_backup_code_*/
render_pipeline/out_prev_*/
render_pipeline/backup_QuestionsImages_*/
render_pipeline/sign_assets/*.pdf
# Poly Haven / downloaded textures and HDRIs (re-fetched by --install; see assets.lock.json)
tools/question_images/assets/*
!tools/question_images/assets/CREDITS.md
*.blend
*.blend1
