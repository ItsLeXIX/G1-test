build/
DerivedData/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ---- Swift Package Manager ----
.build/
.swiftpm/
Packages/

# ---- CocoaPods / Carthage (in case they're added later) ----
Pods/
Carthage/Build/

# ---- Misc ----
*.swp
*~
